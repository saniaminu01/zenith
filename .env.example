# Copy this file to .env and fill in the values.
# Generate a fresh set with: npm run gen:keys

# Private key of the wallet the agent uses as its XMTP identity
XMTP_WALLET_KEY=

# Encryption key for the agent's local SQLite database (64 hex chars / 32 bytes)
XMTP_DB_ENCRYPTION_KEY=

# local | dev | production
XMTP_ENV=production

# Anthropic API key, used for AI-generated replies to free-form messages
ANTHROPIC_API_KEY=
